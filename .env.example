# --- Supabase (required) ---
# Get these from your Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- AI (required for real AI features) ---
# Server-side only. Never expose this in the frontend.
# Set these in Supabase Edge Function secrets (Dashboard -> Settings -> Edge Functions -> Secrets)
AI_PROVIDER=openrouter
AI_API_KEY=sk-or-your-openrouter-key
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# --- App ---
VITE_APP_URL=http://localhost:5173

# --- Optional: Supabase Service Role (for Edge Function database logging) ---
# Set in Supabase Edge Function secrets: SUPABASE_SERVICE_ROLE_KEY
# Get from Supabase Project Settings -> API -> service_role key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
